{
  "pluginName": "mangadex",
  "pluginType": ["tracker"],
  "pluginContractVersion": "2.0.0",
  "hostApiVersion": "1.0.0",
  "iconPath": "images/mangadex-icon.svg",
  "capabilities": ["credential", "search.query", "search.lookup", "enrich", "enrich.cover", "sync.pull", "sync.push", "sync.list", "subscribe.add", "subscribe.remove", "plugin.live"],
  "entrypoints": {
    "pluginModule": "apiwrappers/reg-mangadex/plugin-module.cjs",
    "settingsFile": "apiwrappers/reg-mangadex/mangadex-api-settings.json"
  },
  "syncOptions": {
    "searchRequiresAuth": true,
    "statusVocabulary": {
      "READING":      "reading",
      "COMPLETED":    "completed",
      "PLAN_TO_READ": "plan_to_read",
      "ON_HOLD":      "paused",
      "DROPPED":      "dropped",
      "RE_READING":   "reading"
    },
    "progressAxes": {
      "pull": ["rating"],
      "push": ["rating"]
    },
    "supportedActions": []
  }
}
